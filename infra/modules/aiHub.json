{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "5803566700784997463"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "metadata": {
        "description": "Name of the AI Foundry Hub"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for the hub"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags for the resource"
      }
    },
    "friendlyName": {
      "type": "string",
      "defaultValue": "Zava Storefront AI Hub",
      "metadata": {
        "description": "Friendly name for the hub"
      }
    },
    "hubDescription": {
      "type": "string",
      "defaultValue": "AI Foundry Hub for GPT-4 and Phi models",
      "metadata": {
        "description": "Description of the hub"
      }
    },
    "storageAccountId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Storage account ID for the hub"
      }
    },
    "keyVaultId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Key Vault ID for the hub"
      }
    },
    "applicationInsightsId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application Insights ID for the hub"
      }
    },
    "containerRegistryId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Container Registry ID for the hub"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.MachineLearningServices/workspaces",
      "apiVersion": "2024-04-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Basic",
        "tier": "Basic"
      },
      "kind": "Hub",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "friendlyName": "[parameters('friendlyName')]",
        "description": "[parameters('hubDescription')]",
        "storageAccount": "[if(not(empty(parameters('storageAccountId'))), parameters('storageAccountId'), null())]",
        "keyVault": "[if(not(empty(parameters('keyVaultId'))), parameters('keyVaultId'), null())]",
        "applicationInsights": "[if(not(empty(parameters('applicationInsightsId'))), parameters('applicationInsightsId'), null())]",
        "containerRegistry": "[if(not(empty(parameters('containerRegistryId'))), parameters('containerRegistryId'), null())]",
        "publicNetworkAccess": "Enabled"
      }
    }
  ],
  "outputs": {
    "id": {
      "type": "string",
      "metadata": {
        "description": "The resource ID of the AI Hub"
      },
      "value": "[resourceId('Microsoft.MachineLearningServices/workspaces', parameters('name'))]"
    },
    "name": {
      "type": "string",
      "metadata": {
        "description": "The name of the AI Hub"
      },
      "value": "[parameters('name')]"
    },
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "The principal ID of the system assigned identity"
      },
      "value": "[reference(resourceId('Microsoft.MachineLearningServices/workspaces', parameters('name')), '2024-04-01', 'full').identity.principalId]"
    }
  }
}